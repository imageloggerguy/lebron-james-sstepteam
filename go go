local aeLastTick = 0
local aeOldLookVector = nil

task.spawn(function()
    while true do
        task.wait()
        if not STATE.AE_Enabled then aeOldLookVector = nil continue end
        local character = player.Character
        if not character then aeOldLookVector = nil continue end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not hrp then aeOldLookVector = nil continue end
        if humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then aeOldLookVector = nil continue end
        local currentTime = tick()
        local newLookVector = hrp.CFrame.LookVector
        if not aeOldLookVector then aeOldLookVector = newLookVector aeLastTick = currentTime continue end
        local angleChange = math.acos(math.clamp(aeOldLookVector:Dot(newLookVector), -1, 1))
        if STATE.AE_RequireShift then
            if currentTime - lastShiftRelease > SHIFT_TAP_WINDOW then
                if angleChange > math.rad(5) then aeOldLookVector = newLookVector end
                continue
            end
        end
        if currentTime - aeLastTick >= STATE.AE_MinTimeBetweenTriggers and angleChange > math.rad(5) then
            aeLastTick = currentTime
            aeOldLookVector = newLookVector
        end
        if angleChange > math.rad(STATE.AE_AngleThreshold) and currentTime - aeLastTick <= STATE.AE_CooldownWindow then
            aeLastTick = currentTime
            aeOldLookVector = newLookVector
            task.wait()
            local vel = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(vel.X, STATE.AE_BoostValue, vel.Z)
            if STATE.AE_ShowIndicator then
                local hint = Instance.new("Hint")
                hint.Text = "Angled!"
                hint.Parent = workspace.Terrain
                task.delay(2.5, function()
                    if hint and hint.Parent then hint:Destroy() end
                end)
            end
        end
    end
end)

local jpLastBoost = 0
