local function makePage()
    local p = Instance.new("ScrollingFrame")
    p.Size = UDim2.new(1, 0, 1, -56)
    p.Position = UDim2.new(0, 0, 0, 56)
    p.BackgroundTransparency = 1
    p.BorderSizePixel = 0
    p.ScrollBarThickness = 4
    p.ScrollBarImageColor3 = THEME.Border
    p.CanvasSize = UDim2.new(0, 0, 0, 0)
    p.AutomaticCanvasSize = Enum.AutomaticSize.Y
    p.Visible = false
    p.Parent = content
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 8)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = p
    return p
end

local aePage = makePage()
local jpPage = makePage()
local fpsPage = makePage()
aePage.Visible = true

local sidebarItems = {}

local function makeSidebarItem(name, displayName, callback)
    local item = Instance.new("TextButton")
    item.Size = UDim2.new(1, 0, 0, 42)
    item.BackgroundColor3 = THEME.Sidebar
    item.BorderSizePixel = 0
    item.Text = ""
    item.AutoButtonColor = false
    item.Parent = sidebar
    Instance.new("UICorner", item).CornerRadius = UDim.new(0, 6)

    local icon = Instance.new("Frame")
    icon.Size = UDim2.new(0, 18, 0, 18)
    icon.Position = UDim2.new(0, 12, 0.5, -9)
    icon.BackgroundColor3 = THEME.TextDim
    icon.BorderSizePixel = 0
    icon.Parent = item
    Instance.new("UICorner", icon).CornerRadius = UDim.new(0, 4)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -42, 1, 0)
    lbl.Position = UDim2.new(0, 38, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = displayName
    lbl.TextColor3 = THEME.TextDim
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item

    item.MouseEnter:Connect(function()
        if activeTab ~= name then item.BackgroundColor3 = THEME.ElementBg end
    end)
    item.MouseLeave:Connect(function()
        if activeTab ~= name then item.BackgroundColor3 = THEME.Sidebar end
    end)
    item.MouseButton1Click:Connect(callback)

    sidebarItems[name] = { item = item, icon = icon, lbl = lbl }
end

local function setActive(tab)
    activeTab = tab
    aePage.Visible = (tab == "ae")
    jpPage.Visible = (tab == "jp")
    fpsPage.Visible = (tab == "fps")

    if tab == "ae" then
        contentTitle.Text = "Angle Enhancer"
        contentSubtitle.Text = "Shift-gated angle boost"
    elseif tab == "jp" then
        contentTitle.Text = "JP — Ghost Hitbox"
        contentSubtitle.Text = "Invisible head hitbox, visible heads"
    else
        contentTitle.Text = "FPS Cap"
        contentSubtitle.Text = "Frame rate limiter"
    end

       for n, data in pairs(sidebarItems) do
        if n == tab then
            data.item.BackgroundColor3 = THEME.SidebarActive
            data.icon.BackgroundColor3 = THEME.Accent
            data.lbl.TextColor3 = THEME.TextMain
        else
            data.item.BackgroundColor3 = THEME.Sidebar
            data.icon.BackgroundColor3 = THEME.TextDim
            data.lbl.TextColor3 = THEME.TextDim
        end
    end
end

makeSidebarItem("ae", "Angle Enhancer", function() setActive("ae") end)
makeSidebarItem("jp", "JP Hitbox", function() setActive("jp") end)
makeSidebarItem("fps", "FPS Cap", function() setActive("fps") end)

