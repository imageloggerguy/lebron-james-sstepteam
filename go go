RunService.Heartbeat:Connect(function()
    if not STATE.JP_Enabled or jpIsDiving then return end
    local myChar = player.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myChar:FindFirstChild("Humanoid")
    if not myRoot or not myHumanoid then return end
    if myHumanoid.FloorMaterial ~= Enum.Material.Air then return end
    local now = tick()
    if now - jpLastBoost < STATE.JP_BoostCooldown then return end

    if STATE.JP_AffectPlayers then
        for _, other in ipairs(Players:GetPlayers()) do
            if other == player then continue end
            local oc = other.Character
            if not oc then continue end
            local box = oc:FindFirstChild("EndtiersGhostHitbox")
            local oh = oc:FindFirstChild("Humanoid")
            if not box or not oh then continue end
            local myPos, boxPos = myRoot.Position, box.Position
            local dist = (Vector3.new(myPos.X, boxPos.Y, myPos.Z) - boxPos).Magnitude
            if dist < STATE.JP_DetectionRange and myPos.Y > boxPos.Y and myRoot.Velocity.Y < 0 then
                if oh.FloorMaterial == Enum.Material.Air and box.Velocity.Y > 0 then
                    myRoot.Velocity = Vector3.new(myRoot.Velocity.X, STATE.JP_BoostVelocity, myRoot.Velocity.Z)
                    jpLastBoost = now
                    return
                end
            end
        end
    end

    if STATE.JP_AffectNPCs then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if not obj:IsA("Model") or obj == myChar or Players:GetPlayerFromCharacter(obj) then continue end
            local box = obj:FindFirstChild("EndtiersGhostHitbox")
            local nh = obj:FindFirstChildOfClass("Humanoid")
            if not box or not nh then continue end
            local myPos, boxPos = myRoot.Position, box.Position
            local dist = (Vector3.new(myPos.X, boxPos.Y, myPos.Z) - boxPos).Magnitude
            if dist < STATE.JP_DetectionRange and myPos.Y > boxPos.Y and myRoot.Velocity.Y < 0 then
                if nh.FloorMaterial == Enum.Material.Air and box.Velocity.Y > 0 then
                    myRoot.Velocity = Vector3.new(myRoot.Velocity.X, STATE.JP_BoostVelocity, myRoot.Velocity.Z)
                    jpLastBoost = now
                    return
                end
            end
        end
    end
end)

