local function jpCheckDivingState()
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    local state = humanoid:GetState()
    local root = char:FindFirstChild("HumanoidRootPart")
    if state == Enum.HumanoidStateType.Freefall and root then
        local vel = root.Velocity
        if vel.Y < -20 and vel.Magnitude > 25 then return true end
    end
    local animator = humanoid:FindFirstChild("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local n = track.Animation.Name:lower()
            if n:find("dive") or n:find("tackle") or n:find("slide") or n:find("fall") then return true end
        end
    end
    return char:GetAttribute("Diving") == true or char:GetAttribute("IsDiving") == true
end

RunService.Heartbeat:Connect(function() jpIsDiving = jpCheckDivingState() end)

local function jpComputeBoxSize(headSize)
    local hs = headSize or Vector3.new(2, 1, 1)
    local scale = STATE.JP_HeadScale
    return Vector3.new(
        hs.X * math.max(0.01, scale * STATE.JP_HitboxX),
        hs.Y * math.max(0.01, scale * STATE.JP_HitboxY),
        hs.Z * math.max(0.01, scale * STATE.JP_HitboxZ)
    )
end

local function jpRescaleAll()
    for model, box in pairs(jpGhostBoxes) do
        if box and box.Parent and model and model.Parent then
            local head = model:FindFirstChild("Head")
            if head then box.Size = jpComputeBoxSize(head.Size) end
        end
    end
end

local function jpInstallGhost(model)
    if not model or jpScaledCharacters[model] or model == player.Character then return end
    local head = model:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end
    local box = Instance.new("Part")
    box.Name = "EndtiersGhostHitbox"
    box.Size = jpComputeBoxSize(head.Size)
    box.Transparency = 1
    box.CanCollide = true
    box.Massless = true
    box.Anchored = false
    box.CanTouch = false
    box.CanQuery = false
    box.CastShadow = false
    box.Parent = model
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = head
    weld.Part1 = box
    weld.Parent = box
    box.CFrame = head.CFrame
    jpGhostBoxes[model] = box
    jpScaledCharacters[model] = true
    head:GetPropertyChangedSignal("Size"):Connect(function()
        if box and box.Parent then
            box.Size = jpComputeBoxSize(head.Size)
            box.CFrame = head.CFrame
        end
    end)
end

