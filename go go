-- MASTER TOGGLE (in topbar, before window controls)
local masterBtn = Instance.new("TextButton")
masterBtn.Size = UDim2.new(0, 60, 0, 22)
masterBtn.Position = UDim2.new(1, -150, 0.5, -11)
masterBtn.BackgroundColor3 = THEME.TrackBg
masterBtn.BorderSizePixel = 0
masterBtn.Text = "OFF"
masterBtn.TextColor3 = THEME.TextMain
masterBtn.TextSize = 10
masterBtn.Font = Enum.Font.GothamBold
masterBtn.Parent = topBar
Instance.new("UICorner", masterBtn).CornerRadius = UDim.new(0, 6)

local function refreshMaster()
    local on
    if activeTab == "ae" then on = STATE.AE_Enabled
    elseif activeTab == "jp" then on = STATE.JP_Enabled
    else on = STATE.FPS_Enabled end
    masterBtn.BackgroundColor3 = on and THEME.AccentGreen or THEME.TrackBg
    masterBtn.Text = on and "ON" or "OFF"
end

masterBtn.MouseButton1Click:Connect(function()
    if activeTab == "ae" then
        STATE.AE_Enabled = not STATE.AE_Enabled
    elseif activeTab == "jp" then
        STATE.JP_Enabled = not STATE.JP_Enabled
    else
        STATE.FPS_Enabled = not STATE.FPS_Enabled
        if STATE.FPS_Enabled and applyFPS then applyFPS()
        else if setfpscap then pcall(function() setfpscap(0) end) end end
    end
    refreshMaster()
end)

-- Hook tab switching to refresh master
local origSetActive = setActive
setActive = function(tab)
    origSetActive(tab)
    refreshMaster()
end

-- RightAlt hide GUI
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightAlt then
        main.Visible = not main.Visible
    end
end)

-- Init
setActive("ae")
refreshMaster()

